# Novia Agency — configuration Hostinger (Apache / LiteSpeed)
Options -Indexes
DirectoryIndex index.html index.php

RewriteEngine On

# Les données privées ne sont jamais accessibles depuis le web
RewriteRule ^private(/|$) - [F,L]

# Toutes les requêtes /api/... vont vers api/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
