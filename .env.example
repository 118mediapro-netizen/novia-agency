# Copie ce fichier en .env puis remplis-le.
PORT=3000
# Identifiants de l'espace admin (utilisés au tout premier lancement)
ADMIN_USER=admin
ADMIN_PASSWORD=choisis-un-mot-de-passe-solide
# Mets NODE_ENV=production quand le site est en ligne en HTTPS
NODE_ENV=development
# Dossier où sont stockées les données (à placer sur un disque persistant en production)
DATA_DIR=./data
# Upstash Redis (automatique sur Vercel ; facultatif en local)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
